#!/bin/sh
# Rejects a commit that contains the value of a variable from a local .env file.
# Usage: check-env-secrets staged          (staged changes, from pre-commit)
#        check-env-secrets message <file>  (commit message, from commit-msg)
#
# Values come from every .env and .env.* file in the repo, except .env.template
# and .env.example. Values shorter than 8 characters, or equal to the placeholder
# in the .env.template next to them, are skipped to avoid false positives.
# Matches are reported by variable name and location only, never by value, so
# the secret doesn't end up in terminal output or logs.

mode=$1
message_file=$2

root=$(git rev-parse --show-toplevel) || exit 1

env_files=$(find "$root" \
  \( -name .git -o -name node_modules -o -name target -o -name dist -o -name .angular \) -prune -o \
  -type f \( -name .env -o -name '.env.*' \) ! -name .env.template ! -name .env.example -print)

# No .env files (e.g. a fresh clone): nothing to protect
[ -z "$env_files" ] && exit 0

# One file path per argument, even if a path contains spaces
IFS='
'
set -f
# shellcheck disable=SC2086
set -- $env_files

if [ "$mode" = staged ]; then
  input=$(git diff --cached --no-color --no-ext-diff -U0 --diff-filter=ACMR)
elif [ "$mode" = message ]; then
  input=$(cat "$message_file")
else
  echo "check-env-secrets: unknown mode '$mode'" >&2
  exit 2
fi

matches=$(printf '%s\n' "$input" | awk -v mode="$mode" '
  function trim(s) { sub(/^[ \t]+/, "", s); sub(/[ \t\r]+$/, "", s); return s }

  # Splits a KEY=VALUE line into KEY and VALUE; returns 0 for comments and blank lines
  function parse(line,    eq) {
    line = trim(line)
    if (line == "" || line ~ /^#/) return 0
    sub(/^export[ \t]+/, "", line)
    eq = index(line, "=")
    if (eq < 2) return 0
    KEY = trim(substr(line, 1, eq - 1))
    VALUE = trim(substr(line, eq + 1))
    if (VALUE ~ /^".*"$/ || VALUE ~ /^\047.*\047$/) VALUE = substr(VALUE, 2, length(VALUE) - 2)
    return 1
  }

  function load(env,    dir, template, line) {
    dir = env
    sub(/[^\/]*$/, "", dir)
    template = dir ".env.template"
    split("", placeholder)
    while ((getline line < template) > 0) if (parse(line)) placeholder[KEY] = VALUE
    close(template)
    while ((getline line < env) > 0) {
      if (!parse(line) || length(VALUE) < 8) continue
      if ((KEY in placeholder) && placeholder[KEY] == VALUE) continue
      count++
      names[count] = KEY
      values[count] = VALUE
    }
    close(env)
  }

  function check(text, where,    i) {
    for (i = 1; i <= count; i++)
      if (index(text, values[i])) print "  " names[i] " found in " where
  }

  BEGIN {
    for (i = 1; i < ARGC; i++) load(ARGV[i])
    ARGC = 1  # the .env files were only for loading; now read stdin
  }

  mode == "staged" {
    if ($0 ~ /^\+\+\+ /) { file = substr($0, 5); sub(/^b\//, "", file); next }
    if ($0 ~ /^@@/) { match($0, /\+[0-9]+/); line_no = substr($0, RSTART + 1, RLENGTH - 1) + 0; next }
    if ($0 ~ /^\+/) { check(substr($0, 2), file ":" line_no); line_no++ }
    next
  }

  mode == "message" && $0 !~ /^#/ { check($0, "commit message, line " NR) }
' "$@")

[ -z "$matches" ] && exit 0

echo "Commit rejected: it contains the value of a variable from a local .env file." >&2
echo "" >&2
printf '%s\n' "$matches" >&2
echo "" >&2
echo "  Remove the value and read it from an environment variable instead." >&2
exit 1
